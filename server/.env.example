# ─────────────────────────────────────────────────────────────
#  SERVER ENVIRONMENT VARIABLES  (copy to server/.env — never commit .env)
# ─────────────────────────────────────────────────────────────

# Mongo (Atlas). Leave empty to run with the local file-store fallback
# (server/data/db.json acts as the database — same API, zero setup).
MONGODB_URI=

# JWT secret for admin auth. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Token lifetime (e.g. 12h, 1d, 7d)
JWT_EXPIRES_IN=1d

# Bootstrap admin — created on first start ONLY if no admin exists.
# CHANGE THESE before deploying.
ADMIN_USERNAME=pragadish
ADMIN_PASSWORD=

# Comma-separated list of allowed frontend origins (no trailing slashes).
# Local Vite default: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Port (Render injects this automatically in production)
PORT=5000
