# Root environment overview — see server/.env.example for the real template.
#
# server/.env
#   MONGODB_URI=        # Atlas connection string (empty → local file store)
#   JWT_SECRET=         # random 64+ char string
#   ADMIN_USERNAME=     # default: pragadish
#   ADMIN_PASSWORD=     # bootstrap admin password (required)
#   CORS_ORIGIN=        # http://localhost:5173 (add your Vercel URL in prod)
#
# client/.env (optional)
#   VITE_API_URL=       # https://<your-backend>.onrender.com in production
